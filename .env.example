# Copy to .env and fill in the blanks. Docker Compose (compose.yaml) reads it,
# and so does a run from source.

# --- Docker Compose ---------------------------------------------------------

# The image tag compose.yaml runs: a release such as 0.1.0, main, or latest.
SLIDE_VERSION=latest

# The password of the bundled Postgres. compose.yaml puts it into DATABASE_URL
# as it is, so keep it URL-safe: `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# Where compose.yaml publishes the web port. 127.0.0.1 keeps it for a reverse
# proxy on the same machine; 0.0.0.0 exposes plain HTTP to the network.
SLIDE_BIND=127.0.0.1
SLIDE_PORT=3000

# --- Every run --------------------------------------------------------------

# The public URL members open. The provider sends them back to
# APP_URL/auth/callback, so register that as the client's redirect URI.
APP_URL=http://localhost:3000

# The OpenID Connect client members sign in with, a confidential web client
# using the code flow with PKCE S256. For Google: OIDC_ISSUER is
# https://accounts.google.com and the client is an OAuth client ID of type
# "Web application" from the Google Auth Platform.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Who may sign in: comma-separated email addresses, which the provider must
# have verified. Taking one off signs that member out. Nobody gets in while
# it is empty.
ALLOWED_EMAILS=

# MCP for agents, at APP_URL/mcp, needs nothing more: the app is its own
# OAuth authorization server, signs agents' members in with the settings
# above, and signs its tokens with SESSION_SECRET.

# Encrypts the session cookie: at least 32 characters, `openssl rand -hex 32`.
# Changing it signs everyone out.
SESSION_SECRET=

# Where uploaded images are kept in a run from source (./data/assets when
# unset). compose.yaml sets /data/assets, its volume, itself.
# ASSETS_DIR=

# Where the migrate role reads its NNNN_name.sql files. Empty means
# ./migrations next to the app, which is where the image keeps them.
MIGRATIONS_DIR=

# OpenTelemetry (traces and error logs) for an OTLP/HTTP JSON endpoint such as
# Sensorium. Off while the endpoint is empty. Headers carry the token
# as `Authorization=Bearer sk_...`.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=slide

# --- A run from source ------------------------------------------------------

# Postgres for `bun dev` and `bun run migrate`. compose.yaml sets its own.
DATABASE_URL=postgres://slide:password@localhost:5432/slide
